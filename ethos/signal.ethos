Signal
[ :flow_nexus_types:[ Address Remembering Brief FlowId Request RecordHook Configuration ] ] ; imports
[ Launch.{ Address Remembering Brief }                 ; inputs: start one declared flow
  End.FlowId
  Send.{ Address Request }                            ;   delivery is a later implementation boundary
  Refresh.FlowId
  Hook.RecordHook
  Configure.Configuration ]                           ;   ordinary bootstrap, only while first-Configure permits
[ Launched.FlowId                                     ; outputs: no private request or delivery identities
  Ended Delivered Queued Started.FlowId Refreshed.FlowId Recorded Configured
  Refused.[ NoCapsule RouteClosed AddressBusy           ;   typed refusal vocabulary
            UndeclaredAddress UnknownFlow
            HarnessRefused PermissionRequired
            StoreRefused RecoveryRequired Unavailable
            ConfigurationRefused ConfigureClosed ] ]
[]                                                    ; additional types
